# Cloudinary Configuration
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=

# MongoDB Configuration
MONGODB_URL=mongodb://mongodb:27017/campus_recycle_db

# JWT secret key
JWT_SECRET=

# Frontend HOST
HOST=http://frontend:3000

# Email Configuration (using Gmail)
# ⚠️ IMPORTANT: You must set up a Gmail App Password to send emails
# 
# Step-by-step setup:
# 1. Enable 2-Factor Authentication on your Gmail account:
#    https://myaccount.google.com/security
# 
# 2. Generate an App Password (16-character code):
#    https://myaccount.google.com/apppasswords
#    - Select "Mail" as the app
#    - Select "Other" as the device and name it "Campus Recycle"
# 
# 3. Copy the 16-character app password (remove spaces) and paste below
# 
# Guide: https://support.google.com/accounts/answer/185833
# 
MAIL_HOST=smtp.gmail.com
MAIL_USER=your.email@gmail.com
MAIL_PASS=your_16_character_app_password_here
